{
  "name": "cmms-server",
  "version": "1.0.0",
  "description": "CMMS (CampusCare) REST API - Express + PostgreSQL",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:base": "node scripts/seed-production.js",
    "db:reset": "node scripts/reset.js",
    "test": "jest --runInBand --forceExit",
    "seed:prod": "node scripts/seed-production.js",
    "admin:create": "node scripts/create-admin.js",
    "wipe:demo": "node scripts/wipe-demo.js",
    "email:test": "node scripts/test-email.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}