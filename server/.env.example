# Copy to .env and fill in. NOTE: URL-encode special characters in the password (@ becomes %40).
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cmms
DATABASE_SSL=false
# Used only by `npm test`
TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cmms_test
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
# Optional: Cloudinary for photos (otherwise saved to server/uploads)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional: real email. Without these, emails are only logged to the console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="CampusCare <your-address@example.com>"
# Then test it with:  npm run email:test -- you@example.com

# ---- Sprint 6: Google sign-in --------------------------------------------------------
# OAuth "Web application" client ID from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
# Only emails at this domain may ever sign in.
ALLOWED_EMAIL_DOMAIN=rub.edu.bt
# Fallback password login for Admin/Technician. Defaults: true in dev, false in production.
# ALLOW_PASSWORD_LOGIN=true
